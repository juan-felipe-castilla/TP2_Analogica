* Plantilla Maestro Parametrizada - Telemetría Total AC/DC

* --- ETAPA PREAMPLIFICADORA ---
Q1 N001 N007 N010 0 NPN
RBD N001 N007 {RBD}
C1 N007 NodoInput 10u
Q2 N001 N010 N005 0 NPN
RED N005 0 {RED}
C2 N006 N005 10u

* --- ETAPA DE GANANCIA DE VOLTAJE ---
R1E N001 N006 {R1E}
R2E N006 0 {R2E}
Q3 N003 N006 N011 0 NPN
RCE N001 N003 {RCE}
REE N011 0 {REE}
C3 N011 0 33u

* --- ETAPA DE SALIDA CLASE A (SZIKLAI) ---
V2 N001 0 12
C4 N004 N003 10u
R2S N004 0 {R2S}
R1S N001 N004 {R1S}
Q4 N002 N004 N008 0 NPN
RES N008 0 {RES}
Q5 N008 N002 N001 0 PNP

* --- ACOPLE DE CARGA Y ZOUT ---
RO NodoOut N008 {RO}
C5 N009 NodoOut 10u
RL N009 0 {VAL_RL}

* --- FUENTES DINÁMICAS PARAMETRIZADAS ---
V1 NodoInput 0 SINE(0 {AMP_IN} 2000)
I1 0 NodoOut SINE(0 {AMP_OUT} 2000)

* --- MODELOS BJT DE ALTA PRECISIÓN ---
.model NPN NPN(IS=4.679E-14 NF=1.01 ISE=2.642E-15 NE=1.581 BF=458.7 IKF=0.1371 VAF=52.64 NR=1.019 ISC=2.337E-14 NC=1.164 BR=11.57 IKR=0.1144 VAR=364.5 RB=1 IRB=1.00E-06 RBM=1 RE=0.2598 RC=1 XTB=0 EG=1.11 XTI=3 CJE=1.229E-11 VJE=0.5591 MJE=0.3385 TF=4.689E-10 XTF=160 VTF=2.828 ITF=0.8842 PTF=0 CJC=4.42E-12 VJC=0.1994 MJC=0.2782 XCJC=0.6193 TR=1.00E-32 CJS=0 VJS=0.75 MJS=0.333 FC=0.7936 Vceo=45 Icrating=100m mfg=Philips)
.MODEL PNP PNP (IS=2.9537E-13 BF=201.4 NF=1.0 BR=23.765 NR=1.021 ISE=1.8002E-13 NE=1.5 ISC=7.0433p NC=1.38 VAF=137.0 VAR=8.41 IKF=1.0993 IKR=0.10 RB=1.98 RBM=0.01 IRB=0.011 RE=0.1109 RC=0.01 CJE=2.1982E-10 VJE=0.7211 MJE=0.3685 FC=0.5 CJC=6.8291E-11 VJC=0.5499 MJC=0.3668 XCJC=0.5287 XTB=1.4883 EG=1.2343 XTI=3.0 Vceo=80 Icrating=3 mfg=fairchild)

* --- DIRECTIVAS DE SIMULACIÓN AC Y EXTRACCIÓN ---
.tran 0 10m 8m

* Mediciones macro
.meas TRAN Vout_carga_pp PP V(N009)
.meas TRAN V_prueba_pp PP V(NodoOut)
.meas TRAN Vin_pp PP V(NodoInput)
.meas TRAN Iin_pp PP I(V1)
.meas TRAN I_prueba_pp PP I(I1)

.meas TRAN ganancia PARAM Vout_carga_pp/Vin_pp
.meas TRAN zin_total PARAM Vin_pp/Iin_pp
.meas TRAN zout_total PARAM V_prueba_pp/I_prueba_pp

* --- IMPEDANCIAS DE ENTRADA POR ETAPA ---
* Etapa 1 (Pre Darlington)
.meas TRAN I_C1_pp PP I(C1)
.meas TRAN V_in1_pp PP V(N007)
.meas TRAN Zin_Etapa1 PARAM V_in1_pp / I_C1_pp

* Etapa 2 (VAS - Emisor Común)
.meas TRAN I_C2_pp PP I(C2)
.meas TRAN V_in2_pp PP V(N006)
.meas TRAN Zin_Etapa2 PARAM V_in2_pp / I_C2_pp

* Etapa 3 (Salida Sziklai)
.meas TRAN I_C4_pp PP I(C4)
.meas TRAN V_in3_pp PP V(N004)
.meas TRAN Zin_Etapa3 PARAM V_in3_pp / I_C4_pp

.end